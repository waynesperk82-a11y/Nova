{
  "name": "nova-trader-ai",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "test:backend": "python -m pytest backend/tests -q",
    "doctor": "npx expo-doctor",
    "android:preview": "npx eas-cli build --platform android --profile preview",
    "android:production": "npx eas-cli build --platform android --profile production",
    "ios:preview": "npx eas-cli build --platform ios --profile preview"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.0",
    "@expo/metro-runtime": "~6.1.2",
    "@vercel/analytics": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
